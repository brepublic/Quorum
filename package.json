{
  "name": "quorum",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/brepublic/Quorum.git"
  },
  "dependencies": {
    "@artsy/fresnel": "^7.1.4",
    "@quorum/contracts": "workspace:*",
    "@sentry/react": "^8.8.0",
    "@sentry/tracing": "^7.114.0",
    "@types/file-saver": "^2.0.7",
    "@types/lodash": "^4.17.5",
    "@types/node": "20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^18.3.0",
    "@types/react-helmet": "^6.1.11",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "file-saver": "^2.0.5",
    "flag-icons": "7.5.0",
    "history": "4.10.1",
    "lodash": "^4.17.11",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "18.3.1",
    "react-ga": "^3.3.1",
    "react-helmet": "^6.1.0",
    "react-router": "5.3.4",
    "react-router-dom": "^5.3.4",
    "semantic-ui-css": "^2.5.0",
    "semantic-ui-react": "^2.1.5",
    "typescript": "^5.4.5",
    "vite": "^5.4.2",
    "vite-plugin-svgr": "^4.2.0",
    "vite-tsconfig-paths": "^5.0.1"
  },
  "devDependencies": {
    "@types/history": "^4.7.11",
    "@types/qrcode": "^1.5.6",
    "@types/react-router": "^5.1.20",
    "@vitest/coverage-v8": "^2.0.5",
    "jsdom": "^25.0.0",
    "vitest": "^2.0.5"
  },
  "scripts": {
    "start": "vite",
    "build": "pnpm --filter @quorum/contracts build && tsc && vite build",
    "build:self-host": "pnpm build && pnpm --filter @quorum/rule-schema build && pnpm --filter @quorum/server build && pnpm --filter @quorum/storage-agent build",
    "serve": "vite preview",
    "test": "vitest",
    "test:self-host": "vitest run --exclude '**/*.integration.test.ts'",
    "test:self-host:integration": "vitest run server/src/db/migrations.integration.test.ts server/src/modules/identity/postgres.integration.test.ts server/src/modules/stage3/postgres.integration.test.ts server/src/modules/stage4/postgres.integration.test.ts server/src/modules/stage5/postgres.integration.test.ts server/src/modules/storage/postgres.integration.test.ts server/src/modules/storage-agent/postgres.integration.test.ts server/src/modules/operations/postgres.integration.test.ts",
    "test:coverage": "vitest run --coverage --watch=false",
    "self-host:migrate": "pnpm build:self-host && pnpm --filter @quorum/server migrate",
    "self-host:start": "pnpm build:self-host && pnpm --filter @quorum/server start",
    "self-host:backup": "pnpm build:self-host && pnpm --filter @quorum/server backup",
    "self-host:test-db:up": "node server/scripts/test-db.mjs up",
    "self-host:test-db:down": "node server/scripts/test-db.mjs down",
    "self-host:test-db:reset": "node server/scripts/test-db.mjs reset",
    "release:storage-agent": "pnpm --filter @quorum/storage-agent build && node scripts/build-storage-agent-release.mjs",
    "release:storage-agent:verify": "node scripts/verify-storage-agent-release.mjs",
    "verify:no-legacy-runtime": "node scripts/verify-no-legacy-runtime.mjs",
    "start:storage-agent:desktop": "bash scripts/storage-agent-desktop.sh",
    "release:storage-agent:desktop": "bash scripts/package-storage-agent-desktop.sh"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
