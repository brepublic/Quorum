import { Palette, ListView, Button, LineEdit, CheckBox, ScrollView, VerticalBox, HorizontalBox, ComboBox, TextEdit } from "std-widgets.slint";

export struct FileRow { name: string, size: string, local: string, cache: string, transfer: string, fraction: float, progressing: bool }

component Caption inherits Text { color: #536176; font-size: 13px; overflow: elide; vertical-alignment: center; }
export component MainWindow inherits Window {
    init => { Palette.color-scheme = ColorScheme.light; }
    title: "Quorum Chair Agent";
    preferred-width: 1160px; preferred-height: 800px; min-width: 920px; min-height: 660px;
    background: #f5f7fb;
    default-font-size: 14px;
    in-out property <string> status: "未启动";
    in-out property <bool> running: false;
    in-out property <bool> busy: false;
    in-out property <bool> loaded: false;
    in-out property <bool> closing: false;
    in-out property <bool> confirm-unpair: false;
    in-out property <bool> dirty: false;
    in-out property <string> feedback;
    in-out property <string> confirm-discard;
    in-out property <string> saved-config-path;
    in-out property <string> last-connection;
    in-out property <string> observed;
    in-out property <string> error-text;
    in-out property <string> config-path;
    in-out property <string> server-url: "https://localhost";
    in-out property <string> root-path;
    in-out property <string> certificate;
    in-out property <string> scan-seconds: "30";
    in-out property <string> pairing-code;
    in-out property <string> device-label: "Linux 主席电脑";
    in-out property <string> committee-url;
    in-out property <string> search;
    in-out property <bool> show-deleted: false;
    in-out property <bool> show-settings: false;
    in-out property <bool> show-logs: false;
    in-out property <string> log-filter;
    in-out property <string> log-text;
    in property <[FileRow]> files;
    callback action(string);
    callback choose(string);
    callback filter-changed();

    VerticalBox {
        padding: 24px; spacing: 16px;
        HorizontalBox {
            VerticalBox { padding: 0px; spacing: 5px;
                Text { text: "Quorum  /  主席本地 Agent"; font-size: 22px; font-weight: 700; color: #18273c; }
                Caption { text: root.status + (root.dirty ? " · 未保存" : "") + (root.last-connection == "" ? "" : "  ·  最近连接 " + root.last-connection); }
            }
            Button { text: "启动"; enabled: root.loaded && !root.running && !root.busy && !root.closing; clicked => { root.action("start"); } }
            Button { text: "停止"; enabled: root.running && !root.busy && !root.closing; clicked => { root.action("stop"); } }
            Button { text: "重启"; enabled: root.running && !root.busy && !root.closing; clicked => { root.action("restart"); } }
            Button { text: root.show-settings ? "返回文件" : "设置与配对"; enabled: !root.closing; clicked => { root.show-settings = !root.show-settings; } }
        }
        if root.error-text != "": Rectangle {
            background: #fff0ee; border-radius: 8px; min-height: 46px;
            HorizontalBox { padding: 10px;
                Text { text: root.error-text; color: #9a3028; wrap: word-wrap; }
                Button { text: "关闭"; horizontal-stretch: 0; clicked => {root.error-text = "";} }
            }
        }
        if root.show-settings: ScrollView {
            viewport-height: settings-content.preferred-height;
            settings-content := VerticalBox { padding: 12px; spacing: 8px;
                Text { text: "连接与存储"; font-size: 18px; font-weight: 600; }
                Caption { text: "私有配置"; }
                HorizontalBox { padding: 0px; spacing: 8px;
                    LineEdit { text <=> root.config-path; enabled: !root.running && !root.busy; }
                    Button { text: "选择配置"; enabled: !root.running && !root.busy; clicked => {root.choose("config");} }
                    Button { text: "导入"; enabled: !root.running && !root.busy; clicked => {root.action("load");} }
                }
                Caption { text: "服务器地址"; }
                LineEdit { text <=> root.server-url; enabled: !root.running && !root.busy; }
                Caption { text: "存储目录"; }
                HorizontalBox { padding: 0px; spacing: 8px;
                    LineEdit { text <=> root.root-path; enabled: !root.running && !root.busy; }
                    Button { text: "选择目录"; enabled: !root.running && !root.busy; clicked => {root.choose("root");} }
                }
                Caption { text: "CA 证书"; }
                HorizontalBox { padding: 0px; spacing: 8px;
                    LineEdit { placeholder-text: "服务器证书未受系统信任时选择"; text <=> root.certificate; enabled: !root.running && !root.busy; }
                    Button { text: "选择证书"; enabled: !root.running && !root.busy; clicked => {root.choose("certificate");} }
                }
                HorizontalBox { padding: 0px; spacing: 8px;
                    Caption { text: "完整扫描间隔（秒）"; }
                    LineEdit { text <=> root.scan-seconds; input-type: number; enabled: !root.running && !root.busy; }
                }
                if root.confirm-unpair: VerticalBox {
                    Text { text: "撤销原服务器对此设备的授权？原委员会的本地文件将无法继续通过此设备访问。"; wrap: word-wrap; }
                    HorizontalBox { padding: 0px; spacing: 8px;
                        Button { text: "取消"; enabled: !root.busy; clicked => {root.confirm-unpair = false;} }
                        Button { text: "撤销授权并解除配对"; enabled: !root.running && !root.busy; clicked => {root.action("unpair");} }
                    }
                }
                if !root.loaded: VerticalBox { padding: 0px; spacing: 8px;
                    Text { text: "配对"; font-size: 18px; font-weight: 600; }
                    Caption { text: "设备名称"; }
                    LineEdit { text <=> root.device-label; enabled: !root.busy; }

                }
                Caption { text: "桌面外壳 0.1.0 · Slint 1.17.1 · Agent 协议 2"; }
            }
        }
        if !root.show-settings: VerticalBox { padding: 0px; spacing: 10px;
            HorizontalBox {
                LineEdit { placeholder-text: "搜索文件"; text <=> root.search; edited => {root.filter-changed();} }
                CheckBox { text: "显示已删除"; checked <=> root.show-deleted; toggled => {root.filter-changed();} }
                Button { text: "打开目录"; enabled: root.loaded; clicked => {root.action("open-root");} }
                Button { text: "委员会网页"; enabled: root.loaded; clicked => {root.action("open-web");} }
            }
            Rectangle { height: 34px; background: #e9eef5; border-radius: 6px;
                HorizontalBox { padding-left: 12px; padding-right: 12px;
                    Caption { text: "文件"; horizontal-stretch: 1; }
                    Caption { text: "大小"; width: 85px; }
                    Caption { text: "本地状态"; width: 190px; }
                    Caption { text: "服务器缓存"; width: 190px; }
                    Caption { text: "传输进度"; width: 135px; }
                }
            }
            ListView {
                    for row in root.files: Rectangle { height: 62px; background: #ffffff; border-radius: 5px;
                        HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 12px;
                            Text { text: row.name; color: #18273c; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                            Caption { text: row.size; width: 85px; }
                            Caption { text: row.local; width: 190px; }
                            Caption { text: row.cache; width: 190px; }
                            VerticalLayout { width: 135px; alignment: center; spacing: 5px;
                                Caption { text: row.transfer; }
                                if row.progressing: Rectangle { height: 5px; background: #e9eef5; border-radius: 2px;
                                    Rectangle { width: parent.width * row.fraction; height: parent.height; background: #3375de; border-radius: 2px; }
                                }
                            }
                        }
                    }
            }
            if root.files.length == 0: Caption { text: root.running ? "暂无匹配文件" : "启动 Agent 后读取文件状态"; horizontal-alignment: center; }
            Caption { text: root.observed == "" ? "" : "缓存状态更新于 " + root.observed; }
        }
        if root.confirm-discard != "": VerticalBox { padding: 0px; spacing: 6px;
            Text { text: "当前输入尚未保存，放弃后继续？"; }
            HorizontalBox { padding: 0px;
                Button { text: "取消"; clicked => {root.confirm-discard = "";} }
                Button { text: "放弃修改并继续"; clicked => {root.action("discard-" + root.confirm-discard);} }
            }
        }
        if root.show-settings: VerticalBox { padding: 0px; spacing: 6px;
            if !root.loaded: HorizontalBox { padding: 0px;
                Caption { text: "一次性配对码"; }
                LineEdit { text <=> root.pairing-code; input-type: password; enabled: !root.busy && !root.closing; }
                Button { text: "配对此电脑"; enabled: !root.busy && !root.running && !root.closing; clicked => {root.action("pair");} }
            }
            HorizontalBox { padding: 0px;
                Button { text: "保存设置"; enabled: !root.running && !root.busy && !root.closing; clicked => {root.action("save");} }
                Button { text: "另存为"; enabled: !root.running && !root.busy && !root.closing; clicked => {root.action("save-as");} }
                if root.loaded: Button { text: "解除配对"; enabled: !root.running && !root.busy && !root.closing; clicked => {root.confirm-unpair = true;} }
            }
        }
        if root.feedback != "": Caption { text: root.feedback; }
        HorizontalBox {
            Button { text: root.show-logs ? "收起日志" : "查看日志"; clicked => {root.show-logs = !root.show-logs;} }
            if root.show-logs: LineEdit { placeholder-text: "筛选日志"; text <=> root.log-filter; edited => {root.filter-changed();} }
            if root.show-logs: Button { text: "复制"; clicked => {log-edit.select-all(); log-edit.copy();} }
            if root.show-logs: Button { text: "导出"; clicked => {root.action("export-logs");} }
        }
        log-edit := TextEdit { visible: root.show-logs; text: root.log-text; read-only: true; height: root.show-logs ? 150px : 0px; }
    }
}
