import { Palette, ListView, Button, LineEdit, CheckBox, ScrollView, VerticalBox, HorizontalBox, TextEdit } from "std-widgets.slint";
export { Palette }

export struct CommitteeRow { id: string, name: string, detail: string, paused: bool, host: string, provider: string }

export struct FileRow { id: string, name: string, actual-name: string, stem: string, extension: string, can-open: bool, size: string, local: string, cache: string, local-code: string, cache-code: string, transfer: string, fraction: float, progressing: bool }

component Caption inherits Text { color: Palette.foreground.with-alpha(0.68); font-size: 13px; overflow: elide; vertical-alignment: center; }
component Rule inherits Rectangle { height: 1px; vertical-stretch: 0; background: Palette.foreground.with-alpha(0.12); }
component PathText inherits TextInput { read-only: true; single-line: false; wrap: word-wrap; color: Palette.foreground; font-size: 14px; min-width: 0px; vertical-stretch: 0; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; }
component QuietButton inherits Rectangle {
    in property <string> text;
    in property <string> accessible-name: root.text;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    private property <color> danger-color: Palette.color-scheme == ColorScheme.dark ? #ffaaa5 : #a4262c;
    out property <bool> has-focus: focus.has-focus;
    callback clicked();
    min-width: content.min-width;
    min-height: 32px;
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: 5px;
    background: root.danger && root.enabled ? root.danger-color.with-alpha(touch.pressed ? 0.16 : touch.has-hover ? 0.1 : 0.04) : touch.has-hover && root.enabled ? Palette.foreground.with-alpha(0.06) : transparent;
    border-width: focus.has-focus ? 2px : root.danger ? 1px : 0px;
    border-color: focus.has-focus ? Palette.accent-background : !root.enabled ? Palette.foreground.with-alpha(0.2) : root.danger-color;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-action-default => {if root.enabled {root.clicked();}}
    forward-focus: focus;
    content := HorizontalLayout { padding-left: root.danger ? 12px : 6px; padding-right: root.danger ? 12px : 6px;
        Text { text: root.text; overflow: elide; color: !root.enabled ? Palette.foreground.with-alpha(0.35) : root.danger ? root.danger-color : Palette.foreground.with-alpha(0.8); font-size: root.danger ? 14px : 13px; vertical-alignment: center; horizontal-alignment: root.danger ? center : left; }
    }
    touch := TouchArea { enabled: root.enabled; clicked => {focus.focus(); root.clicked();} }
    focus := FocusScope { width: 0px; height: 0px; enabled: root.enabled;
        key-pressed(event) => {if event.text == " " || event.text == "\n" {root.clicked(); return accept;} return reject;}
    }
}
// A name is selectable across its cell; only the text hit target opens a file.
component FileNameCell inherits Rectangle {
    in property <string> text;
    in property <string> stem: root.text;
    in property <string> extension;
    in property <string> copy-label;
    in property <bool> can-open: false;
    in property <bool> enabled: true;
    in property <length> window-width;
    in property <length> window-height;
    in property <bool> selected;
    changed selected => {if !self.selected {keyboard.clear-focus(); root.close-popup();}}
    callback selected-name();
    callback deselected-name();
    callback outside-clicked();
    callback open-file();
    callback copied(string);
    out property <bool> has-focus: keyboard.has-focus;
    private property <bool> selection-active: keyboard.has-focus || (name-popup.is-open && root.popup-keyboard);
    changed selection-active => {if !self.selection-active {root.deselected-name();}}
    private property <bool> valid: root.enabled && root.text != "" && root.text != "-";
    private property <bool> truncated: measure.preferred-width > root.width - 12px;
    private property <bool> dismissed;
    private property <bool> menu-mode;
    private property <bool> popup-hover;
    private property <bool> popup-keyboard;
    private property <bool> popup-open: name-popup.is-open;
    private property <bool> popup-close-handled;
    changed popup-open => {if !self.popup-open && !root.popup-close-handled {root.outside-clicked(); keyboard.clear-focus();}}
    function show-popup() {root.popup-close-handled = false; name-popup.show();}
    function close-popup() {root.popup-close-handled = true; name-popup.close();}
    private property <length> name-y: (root.height - label.height) / 2;
    private property <color> link-color: Palette.color-scheme == ColorScheme.dark ? #80c7ff : #005aa3;
    min-width: 0px;
    background: root.selected ? Palette.accent-background.with-alpha(0.13) : transparent;
    border-radius: 4px;
    border-width: keyboard.has-focus ? 2px : 0px;
    border-color: Palette.accent-background;
    forward-focus: keyboard;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    accessible-enabled: root.valid;
    accessible-action-default => {if root.can-open && root.valid {root.open-file();}}
    measure := Text { visible: false; text: root.text; font-size: 14px; }
    label := Rectangle { x: 6px; y: root.name-y; width: min(root.width - 12px, measure.preferred-width + 2px); height: max(32px, measure.preferred-height);
        Text { x: 0px; width: parent.width - suffix.width; height: parent.height; text: root.truncated && root.extension != "" ? root.stem : root.text; color: root.can-open ? root.link-color : Palette.foreground; font-size: 14px; vertical-alignment: center; overflow: elide; }
        suffix := Text { x: parent.width - self.width; width: root.truncated && root.extension != "" ? self.preferred-width : 0px; height: parent.height; text: root.truncated ? root.extension : ""; color: root.can-open ? root.link-color : Palette.foreground; font-size: 14px; vertical-alignment: center; }
        if root.can-open && (link-touch.has-hover || keyboard.has-focus): Rectangle { y: parent.height - 1px; height: 1px; background: root.link-color; }
    }
    cell-touch := TouchArea { enabled: root.valid;
        clicked => {root.focus();}
        pointer-event(event) => {if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {root.show-menu();}}
        changed has-hover => {if !self.has-hover {root.dismissed = false;}}
    }
    link-touch := TouchArea { x: label.x; y: label.y; width: label.width; height: label.height; enabled: root.valid && root.can-open; mouse-cursor: pointer;
        clicked => {root.focus(); root.dismissed = true; root.close-popup(); root.open-file();}
        pointer-event(event) => {if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {root.show-menu();}}
    }
    keyboard := FocusScope { width: 0px; height: 0px; enabled: root.valid;
        changed has-focus => {if self.has-focus {root.selected-name(); if root.truncated && !root.dismissed && !root.menu-mode {root.menu-mode = false; root.popup-keyboard = true; root.show-popup();}} else {root.dismissed = false;}}
        key-pressed(event) => {
            if event.text == Key.Escape {root.dismissed = true; root.close-popup(); return accept;}
            if event.modifiers.control && (event.text == "c" || event.text == "C") {root.copy-name(); return accept;}
            if event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) {root.show-menu(); return accept;}
            if event.text == "\n" && root.can-open {root.dismissed = true; root.close-popup(); root.open-file(); return accept;}
            return reject;
        }
    }
    // Use Slint's existing clipboard path; this input never takes focus.
    clipboard := TextInput { visible: false; text: root.text; read-only: true; }
    function show-menu() {root.close-popup(); root.menu-mode = true; root.popup-keyboard = true; root.dismissed = true; keyboard.focus(); root.show-popup();}
    function copy-name() {clipboard.select-all(); clipboard.copy(); root.copied(root.text); root.dismissed = true; root.close-popup();}
    Timer { interval: 500ms; running: root.valid && root.truncated && (cell-touch.has-hover || link-touch.has-hover) && !root.dismissed && !name-popup.is-open;
        triggered => {root.menu-mode = false; root.popup-keyboard = false; root.show-popup();}
    }
    Timer { interval: 100ms; running: name-popup.is-open && !root.menu-mode;
        triggered => {if !cell-touch.has-hover && !link-touch.has-hover && !keyboard.has-focus && !root.popup-keyboard && !root.popup-hover {root.close-popup();}}
    }
    name-popup := PopupWindow {
        close-policy: close-on-click-outside;
        x: max(8px - root.absolute-position.x, min(0px, root.window-width - root.absolute-position.x - self.width - 8px));
        y: max(8px - root.absolute-position.y, min(root.name-y + label.height + 4px, root.window-height - root.absolute-position.y - self.height - 8px));
        width: min(420px, root.window-width - 32px);
        height: min(root.window-height - 32px, full-name.preferred-height + (root.menu-mode ? 64px : 24px));
        Rectangle { background: Palette.background; border-width: 1px; border-color: Palette.foreground.with-alpha(0.3); border-radius: 6px;
            TouchArea { changed has-hover => {root.popup-hover = self.has-hover;} }
            FocusScope { init => {if root.popup-keyboard {self.focus();}}
                key-pressed(event) => {
                    if event.text == Key.Escape {root.dismissed = true; root.close-popup(); if root.popup-keyboard {keyboard.focus();} return accept;}
                    if event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) {root.show-menu(); return accept;}
                    if event.text == Key.Tab {root.dismissed = true; root.close-popup(); keyboard.focus(); return reject;}
                    if root.menu-mode && (event.text == Key.UpArrow || event.text == Key.DownArrow) {copy-button.focus(); return accept;}
                    if event.modifiers.control && (event.text == "c" || event.text == "C") {root.copy-name(); keyboard.focus(); return accept;}
                    if event.text == "\n" {if root.menu-mode {root.copy-name();} else {root.dismissed = true; root.close-popup(); if root.can-open {root.open-file();}} keyboard.focus(); return accept;}
                    return reject;
                }
                VerticalLayout { padding: 12px; spacing: 8px;
                    ScrollView { viewport-width: self.width; viewport-height: full-name.preferred-height;
                        full-name := Text { width: name-popup.width - 24px; text: root.text; font-size: 14px; color: Palette.foreground; wrap: word-wrap; }
                    }
                    copy-button := QuietButton { text: root.copy-label; visible: root.menu-mode; min-height: self.visible ? 32px : 0px; max-height: self.visible ? 32px : 0px; clicked => {root.copy-name(); keyboard.focus();} }
                }
            }
        }
    }
}

component Notice inherits Rectangle {
    in property <string> text;
    in property <bool> error: false;
    in property <bool> success: false;
    in property <bool> dismissible: root.error || root.success;
    in property <string> dismiss-label;
    callback dismissed();
    background: root.error ? #d84b4220 : root.success ? #429c6622 : #c9902d18;
    border-width: 1px;
    border-color: root.error ? #d84b4260 : root.success ? #429c6660 : #c9902d50;
    border-radius: 8px;
    height: notice-content.preferred-height;
    notice-content := HorizontalLayout { padding: 12px; spacing: 12px;
        Text { text: root.success ? "✓" : "!"; color: Palette.foreground; font-weight: 700; vertical-alignment: center; }
        Text { text: root.text; color: Palette.foreground; wrap: word-wrap; horizontal-stretch: 1; }
        if root.dismissible: QuietButton { text: "×"; accessible-name: root.dismiss-label; clicked => {root.dismissed();} }
    }
}
export component MainWindow inherits Window {
    title: "Quorum Chair Agent";
    icon: @image-url("../assets/quorum-agent.svg");
    preferred-width: 960px; preferred-height: 720px; min-width: 760px; min-height: 600px;
    background: Palette.background;
    default-font-size: 14px;
    in-out property <string> pending-navigation;
    in-out property <string> page: "login";
    in-out property <string> email;
    in-out property <string> password;
    in-out property <bool> show-password: false;
    in-out property <string> account-email;
    in-out property <bool> switching: false;
    in-out property <bool> switch-revoked: false;
    in-out property <string> previous-committee;
    in-out property <string> previous-site;
    in-out property <bool> status-delayed: false;
    in property <color> warning-color: Palette.color-scheme == ColorScheme.dark ? #edc36b : #825600;
    in property <color> error-color: Palette.color-scheme == ColorScheme.dark ? #ffaaa5 : #a4262c;
    out property <string> display-status: root.status != "RUNNING" ? root.status : root.status-delayed || root.last-connection-age != "" || root.observed-age != "" ? "STATUS_DELAYED" : root.committee-status == "PAUSED" ? "COMMITTEE_PAUSED_STATUS" : !root.files-loaded ? "STARTING" : "RUNNING";
    out property <bool> field-error: (root.page == "login" || root.page == "password") && (root.error-code == "INCORRECT_CREDENTIALS" || root.error-code == "INVALID_EMAIL" || root.error-code == "PASSWORD_TOO_SHORT" || root.error-code == "PASSWORD_TOO_LONG");
    callback open-file(string);
    // Share exact header/row geometry; reserve a larger gutter after numeric sizes.
    private property <length> names-width: min(1400px, root.width - (root.width < 850px ? 48px : 64px)) - 394px - root.size-column-width;
    in-out property <length> size-column-width: 80px;
    private property <string> size-measure-text;
    size-measure := Text { visible: false; text: root.size-measure-text; font-size: 13px; }
    public function measure-size(text: string) -> length {root.size-measure-text = text; return size-measure.preferred-width;}
    in-out property <string> selected-name-key;
    in-out property <string> focused-file-action;
    in-out property <length> file-scroll;
    in-out property <length> page-scroll;
    in-out property <length> home-scroll;
    in-out property <string> copied-notice;
    callback name-copied(string);
    Timer { interval: 1800ms; running: root.copied-notice != ""; triggered => {root.copied-notice = "";} }
    private property <int> password-focus-request;
    public function focus-password() {root.password-focus-request += 1;}
    private property <int> email-focus-request;
    public function focus-email() {root.email-focus-request += 1;}

    in-out property <string> committee-id;
    in-out property <string> committee-status;
    in-out property <string> storage-provider;
    in-out property <bool> migration-active: false;
    in-out property <string> migration-phase;
    in-out property <string> migration-count;
    in-out property <string> migration-bytes;
    in-out property <string> migration-file;
    in-out property <string> migration-file-bytes;
    in-out property <float> migration-fraction;
    in-out property <float> migration-file-fraction;
    in-out property <string> migration-remaining;
    in-out property <string> migration-error;
    in-out property <string> current-host;
    in-out property <bool> account-setup: false;
    in-out property <bool> transfer-confirmed: false;
    in-out property <bool> candidates-loaded: false;
    in property <[CommitteeRow]> committees;
    in-out property <string> committee-search;
    in-out property <bool> editing: false;
    in-out property <bool> resume-after-edit: false;
    in-out property <bool> language-menu: false;
    in-out property <bool> login-options: false;
    in-out property <bool> login-network: false;
    out property <bool> controls-enabled: root.overwrite-path == "" && !root.confirm-unpair && root.confirm-discard == "" && !root.language-menu && !root.closing && !root.migration-active;
    out property <bool> certificate-error: root.error-stage == "tls" || root.error-code == "UNABLE_TO_GET_ISSUER_CERT_LOCALLY" || root.error-code == "DEPTH_ZERO_SELF_SIGNED_CERT" || root.error-code == "SELF_SIGNED_CERT_IN_CHAIN";
    in-out property <bool> files-loaded: false;
    in-out property <bool> setup-mode: false;
    in-out property <bool> show-advanced: false;
    in-out property <bool> open-pending: false;
    in-out property <string> pending-target;
    in-out property <string> committee-name;
    in-out property <string> language: "";
    pure callback translate(string, string) -> string;
    callback language-changed();
    callback overwrite-decision(bool);
    in-out property <string> overwrite-path;
    in-out property <string> status: "STOPPED";
    in-out property <bool> running: false;
    in-out property <bool> busy: false;
    in-out property <bool> loaded: false;
    in-out property <bool> closing: false;
    in-out property <bool> confirm-unpair: false;
    in-out property <bool> switch-committee: false;
    in-out property <bool> unpair-failed: false;
    in-out property <bool> dirty: false;
    in-out property <string> feedback;
    in-out property <string> confirm-discard;
    in-out property <string> saved-config-path;
    in-out property <string> last-connection;
    in-out property <string> observed;
    in-out property <string> last-connection-age;
    in-out property <string> observed-age;
    in-out property <string> error-code;
    in-out property <string> error-stage;
    out property <string> error-text: root.error-code == "" ? "" :
        (root.error-stage == "" ? "" : root.translate(root.error-stage, root.language) + ": ") + root.translate(root.error-code == "LINK_EXPIRED" && root.account-setup ? "Pairing selection expired" : root.error-code, root.language);
    in-out property <string> config-path;
    in-out property <string> server-url: "https://quorum.sramun.org";
    in-out property <string> root-path;
    in-out property <string> certificate;
    in-out property <string> scan-seconds: "30";
    in-out property <string> pairing-code;
    in-out property <string> device-label: "Linux Chair computer";
    in-out property <string> committee-url;
    in-out property <string> search;
    in-out property <bool> show-deleted: false;
    in-out property <bool> show-settings: false;
    in-out property <bool> show-logs: false;
    in-out property <string> log-filter;
    in-out property <string> log-text;
    in property <[FileRow]> files;
    callback action(string);
    callback choose(string);
    callback filter-changed();
    callback committee-filter-changed();

    // Unhandled background clicks dismiss name selection without consuming controls.
    TouchArea { enabled: root.selected-name-key != ""; clicked => {root.selected-name-key = "";} }
    VerticalLayout {
        padding: 0px; spacing: 0px;
        Rectangle { height: 56px; vertical-stretch: 0; background: Palette.control-background;
            HorizontalLayout { padding-left: 24px; padding-right: 20px; spacing: 10px;
                Rectangle { width: 26px; Image { source: @image-url("../assets/quorum-agent.svg"); width: 26px; height: 26px; y: (parent.height - self.height) / 2; } }
                Text { text: root.translate("Quorum Chair Agent", root.language); color: Palette.foreground; font-size: 16px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                if root.loaded: QuietButton { text: root.translate("Menu", root.language) + "  ≡"; enabled: root.controls-enabled && !root.busy; clicked => {app-menu.show();} }
            }
        }
        Rule { }
        page-view := ScrollView {
            viewport-y <=> root.page-scroll;
            viewport-height: page-layout.preferred-height;
            page-layout := HorizontalLayout { padding: root.width < 850px ? 24px : 32px; spacing: 0px;
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { spacing: root.width < 850px ? 16px : 20px; horizontal-stretch: 2; vertical-stretch: 0;
                    max-width: root.page == "login" || root.page == "password" ? 440px : root.page == "manual" || (root.show-settings && root.page == "home") ? 680px : 1400px;
                    preferred-width: root.page == "login" || root.page == "password" ? 440px : 1400px;
                    if root.page == "manual" || (root.page == "home" && (root.show-settings || root.show-logs)): HorizontalLayout { spacing: 8px; vertical-stretch: 0;
                        QuietButton { text: "‹  " + root.translate(root.loaded ? "Back to sync" : root.setup-mode && root.account-setup ? "Choose committee" : "Back to sign in", root.language); enabled: root.controls-enabled && !root.busy && root.error-stage != "paired-local-recovery"; clicked => {root.action(root.loaded ? "navigate-home" : root.setup-mode ? "back-setup" : "back-manual");} }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if root.switching: HorizontalLayout {
                        QuietButton { text: root.translate(root.switch-revoked ? "Leave switch setup" : "Cancel switch", root.language); enabled: root.controls-enabled && !root.busy && root.error-stage != "paired-local-recovery"; clicked => {root.action("cancel-switch");} }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if root.switch-revoked: Notice { text: root.translate("Previous connection removed", root.language); }
                    VerticalLayout { spacing: 8px;
                        HorizontalLayout { spacing: 16px;
                            Text { text: root.page == "login" ? root.translate("Sign in", root.language) : root.page == "password" ? root.translate("Change initial password", root.language) : root.page == "committees" ? root.translate("Choose committee", root.language) : root.page == "manual" ? root.translate("Use pairing code", root.language) : root.show-logs ? root.translate("Diagnostics", root.language) : root.show-settings ? root.translate(root.setup-mode ? "Choose file storage" : "Configuration", root.language) : root.committee-name;
                                font-size: 26px; font-weight: 600; color: Palette.foreground; wrap: word-wrap; horizontal-stretch: 1; }
                            if root.page == "home" && root.loaded && !root.show-settings && !root.show-logs: Button {
                                text: root.translate(root.status == "STOPPING" ? "STOPPING" : root.running ? "Stop syncing" : "Start syncing", root.language); primary: !root.running;
                                enabled: root.controls-enabled && !root.busy && !root.dirty;
                                clicked => {root.action(root.running ? "stop" : "start");}
                            }
                            if root.page == "home" && root.loaded && root.show-settings && !root.editing: Button { text: root.translate(root.status == "STOPPING" ? "STOPPING" : root.running ? "Stop to edit" : "Edit settings", root.language); enabled: root.controls-enabled && !root.busy; clicked => {root.action("edit-settings");} }
                        }
                        if root.page == "login": Caption { text: root.translate("Sign in to connect a committee", root.language); }
                        if root.page == "password" || root.page == "committees": Caption { text: root.server-url; }
                        if root.page == "committees": HorizontalLayout { spacing: 12px;
                            PathText { text: root.account-email; horizontal-stretch: 1; }
                            QuietButton { text: root.translate("Switch account", root.language); enabled: root.controls-enabled && !root.busy; clicked => {root.action("logout");} }
                        }
                        if root.page == "home" && !root.show-settings && !root.show-logs: HorizontalLayout { spacing: 8px;
                            Rectangle { width: 7px; height: 18px; Rectangle { width: 7px; height: 7px; y: (parent.height - self.height) / 2; border-radius: 4px; background: root.display-status == "RUNNING" ? #429c66 : root.display-status == "DISCONNECTED" || root.display-status == "STATUS_DELAYED" || root.display-status == "COMMITTEE_PAUSED_STATUS" ? root.warning-color : Palette.foreground.with-alpha(0.4); } }
                            Caption { text: root.translate(root.display-status, root.language); horizontal-stretch: 1; }
                            if root.display-status == "COMMITTEE_PAUSED_STATUS": Caption { text: root.translate("Connected", root.language); }
                            if root.last-connection-age != "": Caption { max-width: 290px; text: root.translate("Last connected", root.language) + " " + root.last-connection-age; }
                        }
                        if root.editing && root.dirty: Caption { text: root.translate("Unsaved changes", root.language); }
                    }

                    if root.error-text != "" && !root.confirm-unpair && !root.field-error: Notice { text: root.error-text; error: true; dismiss-label: root.translate("Close", root.language);
                        dismissed => {root.error-code = ""; root.error-stage = "";}
                    }
                    if root.feedback != "": Notice {
                        text: root.translate(root.feedback, root.language);
                        success: root.feedback != "Unpaired locally; server authorization has not been confirmed revoked";
                        dismissible: true; dismiss-label: root.translate("Close", root.language);
                        dismissed => {root.feedback = "";}
                    }

                    if root.page == "login" || root.page == "password": VerticalLayout { spacing: 18px;
                        if root.page == "login": VerticalLayout { spacing: 7px;
                            HorizontalLayout {
                                Caption { text: root.translate("Quorum website", root.language); horizontal-stretch: 1; }
                                QuietButton { text: root.translate("Certificate settings", root.language) + (root.login-network ? "  ▴" : "  ▾"); enabled: root.controls-enabled && !root.busy; clicked => {root.login-network = !root.login-network;} }
                            }
                            LineEdit { text <=> root.server-url; accessible-label: root.translate("Quorum website", root.language); enabled: root.controls-enabled && !root.busy; }
                            if root.login-network || root.certificate-error: VerticalLayout { spacing: 8px;
                                Caption { text: root.translate("CA certificate", root.language); }
                                HorizontalLayout { spacing: 12px;
                                    PathText { enabled: root.controls-enabled; text: root.certificate == "" ? root.translate("System trusted certificates", root.language) : root.certificate; horizontal-stretch: 1; }
                                    Button { text: root.translate("Choose certificate", root.language); enabled: root.controls-enabled && !root.busy; clicked => {root.choose("certificate");} }
                                }
                                if root.certificate != "": QuietButton { text: root.translate("Use system certificates", root.language); enabled: root.controls-enabled && !root.busy; clicked => {root.certificate = "";} }
                            }
                        }
                        if root.page == "login": VerticalLayout { spacing: 7px;
                            Caption { text: root.translate("Email", root.language); }
                            LineEdit { private property <int> focus-request: root.email-focus-request; changed focus-request => {self.focus();} text <=> root.email; enabled: root.controls-enabled && !root.busy; accessible-label: root.translate("Email", root.language); accepted => {password-field.focus();} }
                            if root.error-code == "INVALID_EMAIL": Text { text: "! " + root.translate(root.error-code, root.language); color: root.error-color; wrap: word-wrap; }
                        }
                        VerticalLayout { spacing: 7px;
                            Caption { text: root.translate(root.page == "password" ? "New password" : "Password", root.language); }
                            if root.page == "password": Caption { text: root.translate("Password length", root.language); }
                            HorizontalLayout { spacing: 8px;
                            password-field := LineEdit { private property <int> focus-request: root.password-focus-request; changed focus-request => {self.focus();} text <=> root.password; horizontal-stretch: 1; input-type: root.show-password ? InputType.text : InputType.password; enabled: root.controls-enabled && !root.busy; accessible-label: root.translate(root.page == "password" ? "New password" : "Password", root.language); accepted => {if root.controls-enabled && !root.busy && root.password != "" && (root.page == "password" || (root.email != "" && root.server-url != "")) {root.action(root.page == "password" ? "change-password" : "login");}} }
                                QuietButton { text: root.translate(root.show-password ? "Hide password" : "Show password", root.language); enabled: root.controls-enabled && !root.busy; clicked => {root.show-password = !root.show-password;} }
                            }
                        }
                        if root.field-error && root.error-code != "INVALID_EMAIL": Text { text: "! " + root.translate(root.error-code, root.language); color: root.error-color; wrap: word-wrap; }
                        Button { text: root.translate(root.busy ? "Connecting" : root.page == "password" ? "Save and continue" : "Sign in", root.language); primary: true; horizontal-stretch: 1; min-height: 38px;
                            enabled: root.controls-enabled && !root.busy && root.password != "" && (root.page == "password" || (root.email != "" && root.server-url != ""));
                            clicked => {root.action(root.page == "password" ? "change-password" : "login");}
                        }
                        Rule { }
                        HorizontalLayout { spacing: 8px;
                            QuietButton { text: "Language / 语言"; enabled: root.controls-enabled; clicked => {root.language-menu = true;} }
                            Rectangle { horizontal-stretch: 1; }
                            if !root.switching || root.page == "password": QuietButton { text: root.translate(root.page == "password" ? "Back to sign in" : "More connection options", root.language) + (root.page == "password" ? "" : root.login-options ? "  ▴" : "  ▾"); enabled: root.controls-enabled && !root.busy;
                                clicked => {if root.page == "password" {root.action("logout");} else {root.login-options = !root.login-options;}}
                            }
                        }
                        if root.page == "login" && root.login-options && !root.switching: Rectangle { background: Palette.control-background; border-radius: 8px; border-width: 1px; border-color: Palette.foreground.with-alpha(0.1); height: connection-options.preferred-height;
                            connection-options := VerticalLayout { padding: 14px; spacing: 6px;
                                QuietButton { text: root.translate("Open connection file", root.language); enabled: root.controls-enabled && !root.busy; clicked => {root.action("import");} }
                                QuietButton { text: root.translate("Use pairing code", root.language); enabled: root.controls-enabled && !root.busy; clicked => {root.action("enter-manual");} }
                            }
                        }
                    }

                    if root.page == "committees": VerticalLayout { spacing: 16px;
                        HorizontalLayout { spacing: 12px;
                            LineEdit { enabled: root.controls-enabled; text <=> root.committee-search; placeholder-text: root.translate("Search committees", root.language); accessible-label: root.translate("Search committees", root.language); edited => {root.committee-filter-changed();} horizontal-stretch: 1; }
                            QuietButton { text: root.translate("Refresh", root.language); enabled: root.controls-enabled && !root.busy; clicked => {root.action("list-committees");} }
                        }
                        if !root.candidates-loaded || root.committees.length == 0: Rectangle { height: 150px; background: Palette.control-background; border-radius: 8px;
                            VerticalLayout { padding: 24px; alignment: center;
                                Text { text: root.translate(!root.candidates-loaded ? root.busy ? "Loading committees" : "Retry loading committees" : root.committee-search == "" ? "No available committees" : "No matching committees", root.language); wrap: word-wrap; horizontal-alignment: center; color: Palette.foreground; }
                            }
                        }
                        for committee in root.committees: Rectangle { height: candidate-content.preferred-height; background: Palette.control-background; border-radius: 9px; border-width: 1px; border-color: Palette.foreground.with-alpha(0.12);
                            candidate-content := VerticalLayout { padding: 18px; spacing: 10px;
                                HorizontalLayout { spacing: 12px;
                                    Text { text: committee.name; font-size: 18px; font-weight: 600; wrap: word-wrap; color: Palette.foreground; horizontal-stretch: 1; }
                                    if committee.paused: Text { text: root.translate("Paused", root.language); color: root.warning-color; font-weight: 600; }
                                    Button { text: root.translate(committee.host == "" ? "Continue" : "Replace chair computer", root.language); enabled: root.controls-enabled && !root.busy; clicked => {root.committee-id = committee.id; root.action("select-committee");} }
                                }
                                if committee.detail != "": Caption { text: committee.detail; wrap: word-wrap; }
                                HorizontalLayout { spacing: 16px;
                                    Caption { text: root.translate(committee.provider == "" ? "No storage configured" : committee.provider, root.language); }
                                    if committee.host != "": Caption { text: root.translate("Current computer", root.language) + " · " + committee.host; }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                if committee.paused: Caption { text: root.translate("Committee paused reminder", root.language); wrap: word-wrap; }
                            }
                        }
                        HorizontalLayout { Rectangle { horizontal-stretch: 1; } QuietButton { text: "Language / 语言"; enabled: root.controls-enabled; clicked => {root.language-menu = true;} } }
                    }

                    if root.page == "home" && !root.show-logs && (!root.show-settings || root.setup-mode) && root.committee-status == "PAUSED": Notice { text: root.translate(root.setup-mode ? "Committee paused reminder" : "Paused changes reminder", root.language); }
                    if root.page == "home" && !root.show-logs && (!root.show-settings || root.setup-mode) && (root.storage-provider == "SERVER_VOLUME" || root.storage-provider == "S3_COMPATIBLE"): Notice { text: root.translate(root.storage-provider, root.language) + " · " + root.translate("Existing storage retained", root.language); }

                    if root.page == "manual" || (root.page == "home" && root.show-settings): VerticalLayout { spacing: 16px;
                        if root.page == "manual": Caption { text: root.translate("Pairing code source", root.language); wrap: word-wrap; }
                        if root.page == "manual": VerticalLayout { spacing: 7px;
                            Caption { text: root.translate("Quorum website", root.language); }
                            LineEdit { text <=> root.server-url; accessible-label: root.translate("Quorum website", root.language); enabled: root.controls-enabled && !root.busy; }
                        }
                        if root.page == "manual": VerticalLayout { spacing: 7px;
                            Caption { text: root.translate("One-time pairing code", root.language); }
                            LineEdit { accessible-label: root.translate("One-time pairing code", root.language); text <=> root.pairing-code; enabled: root.controls-enabled && !root.busy; }
                        }
                        if root.page != "manual": VerticalLayout { spacing: 8px;
                            Caption { text: root.translate(root.setup-mode ? "Selected committee" : "Current connection", root.language); }
                            Text { text: root.committee-name; font-size: 19px; font-weight: 600; wrap: word-wrap; color: Palette.foreground; }
                            PathText { enabled: root.controls-enabled; text: root.server-url; }
                            if root.loaded: HorizontalLayout { spacing: 12px;
                                Button { text: root.translate("Change committee", root.language); min-width: 160px; min-height: 36px; enabled: root.controls-enabled && !root.busy && !root.dirty; clicked => {root.action("confirm-switch");} }
                                Rectangle { horizontal-stretch: 1; }
                                QuietButton { text: root.translate("Disconnect", root.language); danger: true; min-width: 160px; min-height: 36px; enabled: root.controls-enabled && !root.busy && !root.dirty; clicked => {root.action("confirm-unpair");} }
                            }
                        }
                        if root.setup-mode && root.current-host != "": Rectangle { background: #c9902d18; border-radius: 8px; height: transfer-content.preferred-height;
                            transfer-content := VerticalLayout { padding: 16px; spacing: 10px;
                                Text { text: root.translate("Current computer", root.language) + " · " + root.current-host; wrap: word-wrap; color: Palette.foreground; }
                                Text { text: root.translate("Replacing computer consequence", root.language); wrap: word-wrap; color: Palette.foreground; }
                                CheckBox { text: root.translate("Confirm replacing computer", root.language); checked <=> root.transfer-confirmed; enabled: root.controls-enabled && !root.busy; }
                            }
                        }
                        Rule { }
                        VerticalLayout { spacing: 10px;
                            Text { text: root.translate("Storage folder", root.language); font-size: 16px; font-weight: 600; color: Palette.foreground; }
                            HorizontalLayout { spacing: 16px;
                                PathText { enabled: root.controls-enabled; text: root.root-path == "" ? root.translate("Choose a storage directory.", root.language) : root.root-path; horizontal-stretch: 1; }
                                if !root.loaded || root.editing: Button { text: root.translate(root.loaded ? "Relocate moved folder" : "Choose directory", root.language); enabled: root.controls-enabled && !root.running && !root.busy; clicked => {root.choose("root");} }
                                if root.loaded && !root.editing: Button { text: root.translate("Open directory", root.language); enabled: root.controls-enabled; clicked => {root.action("open-root");} }
                            }
                        }
                        Rule { }
                        HorizontalLayout { QuietButton { text: root.translate("Advanced settings", root.language) + (root.show-advanced ? "  ▴" : "  ▾"); enabled: root.controls-enabled; clicked => {root.show-advanced = !root.show-advanced;} } Rectangle { horizontal-stretch: 1; } }
                        if root.show-advanced: VerticalLayout { spacing: 18px;
                            if !root.loaded: VerticalLayout { spacing: 7px;
                                Caption { text: root.translate("Device name", root.language); }
                                LineEdit { accessible-label: root.translate("Device name", root.language); text <=> root.device-label; enabled: root.controls-enabled && !root.busy; }
                            }
                            VerticalLayout { spacing: 7px;
                                Caption { text: root.translate("CA certificate", root.language); }
                                HorizontalLayout { spacing: 12px;
                                    PathText { enabled: root.controls-enabled; text: root.certificate == "" ? root.translate("System trusted certificates", root.language) : root.certificate; horizontal-stretch: 1; }
                                    if !root.loaded || root.editing: Button { text: root.translate("Choose certificate", root.language); enabled: root.controls-enabled && !root.running && !root.busy; clicked => {root.choose("certificate");} }
                                }
                                if root.certificate != "" && (!root.loaded || root.editing): QuietButton { text: root.translate("Use system certificates", root.language); enabled: root.controls-enabled && !root.busy; clicked => {root.certificate = "";} }
                            }
                            HorizontalLayout { spacing: 12px;
                                Caption { text: root.translate("Full scan interval (seconds)", root.language); horizontal-stretch: 1; }
                                if !root.loaded || root.editing: LineEdit { accessible-label: root.translate("Full scan interval (seconds)", root.language); text <=> root.scan-seconds; input-type: number; max-width: 90px; enabled: root.controls-enabled && !root.running && !root.busy; }
                                if root.loaded && !root.editing: Text { text: root.scan-seconds; color: Palette.foreground; }
                            }
                            if !root.setup-mode: VerticalLayout { spacing: 8px;
                                Caption { text: root.translate("Private configuration", root.language); }
                                PathText { enabled: root.controls-enabled; text: root.config-path; }
                                HorizontalLayout { spacing: 12px;
                                    if !root.loaded: QuietButton { text: root.translate("Save settings", root.language); enabled: root.controls-enabled && !root.busy; clicked => {root.action("save");} }
                                    QuietButton { text: root.translate("Save as", root.language); enabled: root.controls-enabled && !root.busy && !root.running; clicked => {root.action("save-as");} }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        }
                        if root.setup-mode || root.page == "manual" || root.editing: VerticalLayout { spacing: 16px;
                            Rule { }
                            HorizontalLayout { spacing: 12px; alignment: end;
                                Button { text: root.translate(root.resume-after-edit ? "Cancel and resume" : "Cancel", root.language); enabled: root.controls-enabled && !root.busy && root.error-stage != "paired-local-recovery";
                                    clicked => {root.action(root.setup-mode ? "back-setup" : root.page == "manual" ? "back-manual" : "cancel-settings");} }
                                Button { text: root.translate(root.busy ? "Working" : root.setup-mode ? root.switching ? "Review switch" : "Confirm directory and start" : root.page == "manual" ? "Pair this computer" : root.resume-after-edit ? "Save and resume" : "Save settings", root.language); primary: true;
                                    enabled: root.controls-enabled && !root.busy && !root.running && root.root-path != "" && (root.page != "manual" || root.pairing-code != "") && (root.current-host == "" || !root.setup-mode || root.transfer-confirmed);
                                    clicked => {root.action(root.setup-mode ? root.switching ? "confirm-switch-target" : root.account-setup ? "account-pair" : "setup-pair" : root.page == "manual" ? "pair" : "save");}
                                }
                            }
                        }
                    }

                    if root.page == "home" && !root.show-settings && !root.show-logs: VerticalLayout { spacing: 16px;
                        if root.files.length > 0 || root.search != "" || root.show-deleted: HorizontalLayout { spacing: 12px;
                            LineEdit { enabled: root.controls-enabled; placeholder-text: root.translate("Search files", root.language); accessible-label: root.translate("Search files", root.language); text <=> root.search; edited => {root.filter-changed();} horizontal-stretch: 1; }
                            CheckBox { enabled: root.controls-enabled; text: root.translate("Show deleted", root.language); checked <=> root.show-deleted; toggled => {root.filter-changed();} }
                        }
                        if root.files.length > 0: VerticalLayout { spacing: 0px;
                            Rectangle { height: 36px; background: Palette.alternate-background; border-radius: 6px;
                                HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 12px;
                                    Rectangle { width: root.names-width * 0.45; Caption { x: 6px; width: parent.width - 6px; text: root.translate("Files", root.language); } }
                                    Rectangle { width: root.names-width * 0.55; Caption { x: 6px; width: parent.width - 6px; text: root.translate("Actual filename", root.language); } }
                                    Caption { text: root.translate("Size", root.language); width: root.size-column-width; horizontal-alignment: right; }
                                    Rectangle { width: 4px; }
                                    Caption { text: root.translate("Local status", root.language); width: 150px; }
                                    Caption { text: root.translate("Server cache", root.language); horizontal-stretch: 1; }
                                }
                            }
                            ListView { viewport-y <=> root.file-scroll; height: max(180px, root.height - 405px);
                                for row in root.files: file-row := Rectangle {
                                    private property <bool> local-log: row.local-code == "FAILED" || row.local-code == "RETRYING";
                                    private property <bool> conflict: row.local-code == "CONFLICT";
                                    private property <bool> cache-log: row.cache-code == "REFILL_FAILED" && !self.local-log;
                                    height: max(row.progressing || self.local-log || self.conflict || self.cache-log ? 80px : 64px, row-content.min-height);
                                    background: Palette.control-background;
                                    row-content := HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 12px;
                                        logical-name := FileNameCell { width: root.names-width * 0.45; text: row.name; copy-label: root.translate("Copy file name", root.language); enabled: root.controls-enabled;
                                            window-width: root.width; window-height: root.height; selected: root.selected-name-key == row.id + ":name";
                                            selected-name => {root.focused-file-action = ""; root.selected-name-key = row.id + ":name";}
                                            deselected-name => {if root.selected-name-key == row.id + ":name" {root.selected-name-key = "";}}
                                            outside-clicked => {root.selected-name-key = "";}
                                            copied(value) => {root.name-copied(value); root.copied-notice = root.translate("Copied", root.language);}
                                        }
                                        actual-name := FileNameCell { accessible-role: button; width: root.names-width * 0.55; text: row.actual-name; stem: row.stem; extension: row.extension; can-open: row.can-open; copy-label: root.translate("Copy actual filename", root.language); enabled: root.controls-enabled;
                                            window-width: root.width; window-height: root.height; selected: root.selected-name-key == row.id + ":actual";
                                            selected-name => {root.focused-file-action = ""; root.selected-name-key = row.id + ":actual";}
                                            deselected-name => {if root.selected-name-key == row.id + ":actual" {root.selected-name-key = "";}}
                                            outside-clicked => {root.selected-name-key = "";}
                                            open-file => {root.open-file(row.id);}
                                            copied(value) => {root.name-copied(value); root.copied-notice = root.translate("Copied", root.language);}
                                        }
                                        Text { width: root.size-column-width; text: row.size; font-size: 13px; color: Palette.foreground; horizontal-alignment: right; vertical-alignment: center; wrap: no-wrap; }
                                        Rectangle { width: 4px; }
                                        VerticalLayout { width: 150px; spacing: 4px; alignment: center; padding-top: 8px; padding-bottom: 8px;
                                            Text { text: (file-row.conflict || file-row.local-log ? "! " : "") + row.local; color: row.local-code == "FAILED" || file-row.conflict ? root.error-color : row.local-code == "RETRYING" ? root.warning-color : Palette.foreground; wrap: word-wrap; font-size: 13px; }
                                            if row.progressing: Caption { text: row.transfer; font-size: 13px; }
                                            if row.progressing: Rectangle { height: 4px; background: Palette.alternate-background; border-radius: 2px;
                                                Rectangle { width: parent.width * row.fraction; height: parent.height; background: Palette.accent-background; border-radius: 2px; }
                                            }
                                            local-action := QuietButton { text: root.translate(file-row.conflict ? "Resolve on website" : "View logs", root.language); visible: file-row.conflict || file-row.local-log; enabled: root.controls-enabled && self.visible;
                                                min-height: self.visible ? 32px : 0px; max-height: self.visible ? 32px : 0px;
                                                changed has-focus => {if self.has-focus {root.focused-file-action = row.id + ":local";} else if self.visible && root.focused-file-action == row.id + ":local" {root.focused-file-action = "";}}
                                                changed visible => {if !self.visible && root.focused-file-action == row.id + ":local" {if row.actual-name != "-" {actual-name.focus();} else {logical-name.focus();}}}
                                                clicked => {root.action(file-row.conflict ? "open-conflicts" : "navigate-logs");}
                                            }
                                        }
                                        VerticalLayout { width: 140px; spacing: 4px; alignment: center; padding-top: 8px; padding-bottom: 8px;
                                            Text { text: (row.cache-code == "REFILL_FAILED" ? "! " : "") + row.cache; color: row.cache-code == "REFILL_FAILED" ? root.error-color : Palette.foreground; wrap: word-wrap; font-size: 13px; }
                                            cache-action := QuietButton { text: root.translate("View logs", root.language); visible: file-row.cache-log; enabled: root.controls-enabled && self.visible; min-height: self.visible ? 32px : 0px; max-height: self.visible ? 32px : 0px;
                                                changed has-focus => {if self.has-focus {root.focused-file-action = row.id + ":cache";} else if self.visible && root.focused-file-action == row.id + ":cache" {root.focused-file-action = "";}}
                                                changed visible => {if !self.visible && root.focused-file-action == row.id + ":cache" {if row.actual-name != "-" {actual-name.focus();} else {logical-name.focus();}}}
                                                clicked => {root.action("navigate-logs");}
                                            }
                                        }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.foreground.with-alpha(0.08); }
                                }
                            }
                        }
                        if root.files.length == 0: Rectangle { height: 220px; background: Palette.control-background; border-radius: 8px;
                            VerticalLayout { padding: 32px; alignment: center; spacing: 12px;
                                Text { text: root.translate(root.running ? root.status == "DISCONNECTED" ? "Waiting to reconnect" : !root.files-loaded ? "Loading files" : root.search != "" ? "No matching files" : "No files yet" : "Start the Agent to load file status", root.language); horizontal-alignment: center; wrap: word-wrap; font-size: 17px; color: Palette.foreground; }
                            }
                        }
                        Rule { }
                        HorizontalLayout { spacing: 16px;
                            VerticalLayout { spacing: 5px; horizontal-stretch: 1;
                                Caption { text: root.translate("Storage folder", root.language); }
                                PathText { enabled: root.controls-enabled; text: root.root-path; }
                            }
                            Button { text: root.translate("Open directory", root.language); enabled: root.controls-enabled; clicked => {root.action("open-root");} }
                        }
                        if root.observed-age != "": Caption { text: root.translate("Cache status updated", root.language) + " " + root.observed-age; }
                    }

                    if root.page == "home" && root.show-logs: VerticalLayout { spacing: 16px;
                        HorizontalLayout { spacing: 8px;
                            LineEdit { enabled: root.controls-enabled; placeholder-text: root.translate("Filter logs", root.language); accessible-label: root.translate("Filter logs", root.language); text <=> root.log-filter; edited => {root.filter-changed();} horizontal-stretch: 1; }
                            Button { text: root.translate("Copy", root.language); enabled: root.controls-enabled; clicked => {log-edit.select-all(); log-edit.copy();} }
                            Button { text: root.translate("Export", root.language); enabled: root.controls-enabled && !root.busy; clicked => {root.action("export-logs");} }
                        }
                        log-edit := TextEdit { enabled: root.controls-enabled; text: root.log-text; read-only: true; height: max(260px, root.height - 330px); }

                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
    app-menu := PopupWindow {
        x: root.width - self.width - 20px; y: 52px; width: 245px; height: menu-content.preferred-height;
        Rectangle { background: Palette.background; border-radius: 8px; border-width: 1px; border-color: Palette.foreground.with-alpha(0.2);
            menu-content := VerticalLayout { padding: 8px; spacing: 2px;
                QuietButton { text: root.translate("Configuration", root.language); clicked => {app-menu.close(); root.action("navigate-settings");} }
                QuietButton { text: root.translate("Diagnostics", root.language); clicked => {app-menu.close(); root.action("navigate-logs");} }
                QuietButton { visible: !root.show-settings && !root.show-logs; max-height: self.visible ? 32px : 0px; min-height: self.visible ? 32px : 0px; text: root.translate("Restart sync", root.language); enabled: root.running && !root.busy; clicked => {app-menu.close(); root.action("restart");} }
                QuietButton { text: root.translate("Committee web page", root.language); clicked => {app-menu.close(); root.action("open-web");} }
                Rule { }
                QuietButton { text: root.translate("Change committee", root.language); clicked => {app-menu.close(); root.action("confirm-switch");} }
                QuietButton { text: "Language / 语言"; clicked => {app-menu.close(); root.language-menu = true;} }
            }
        }
    }
    if root.language-menu: Rectangle {
        background: #00000060;
        TouchArea { clicked => {root.language-menu = false;} }
        FocusScope {
            init => {self.focus();}
            key-pressed(event) => {if event.text == Key.Escape {root.language-menu = false; return accept;} return reject;}
            Rectangle { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: 340px; height: language-content.preferred-height; background: Palette.background; border-radius: 12px;
                language-content := VerticalLayout { padding: 24px; spacing: 16px;
                    Text { text: "Language / 语言"; color: Palette.foreground; font-size: 20px; font-weight: 600; }
                    Button { text: "English"; checkable: true; checked: root.language == "en"; horizontal-stretch: 1; clicked => {root.language = "en"; root.language-changed(); root.language-menu = false;} }
                    Button { text: "简体中文"; checkable: true; checked: root.language == "zh-CN"; horizontal-stretch: 1; clicked => {root.language = "zh-CN"; root.language-changed(); root.language-menu = false;} }
                    QuietButton { text: root.translate("Cancel", root.language); clicked => {root.language-menu = false;} }
                }
            }
        }
    }
    if root.confirm-unpair: Rectangle {
        background: #18273c80;
        TouchArea { }
        FocusScope {
            init => {cancel-unpair.focus();}
            key-pressed(event) => {
                if event.text == Key.Escape && !root.busy {root.confirm-unpair = false; return accept;}
                return reject;
            }
            Rectangle {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: 580px; height: min(root.height - 48px, 148px + confirmation-body.preferred-height);
                background: Palette.background; border-radius: 12px;
                VerticalLayout { padding: 24px; spacing: 16px;
                    Text { text: root.translate(root.switch-committee ? "Change committee?" : "Unpair this computer?", root.language); font-size: 20px; font-weight: 700; color: Palette.foreground; }
                    ScrollView { viewport-height: confirmation-body.preferred-height;
                        confirmation-body := VerticalLayout { spacing: 12px;
                            Text { text: root.switch-committee ? root.previous-committee : root.committee-name; color: Palette.foreground; font-weight: 600; wrap: word-wrap; }
                            PathText { text: root.switch-committee ? root.previous-site : root.server-url; }
                            if root.switch-committee: VerticalLayout { spacing: 6px;
                                Caption { text: root.translate("Switch to", root.language); }
                                Text { text: root.committee-name; color: Palette.foreground; font-weight: 600; wrap: word-wrap; }
                                PathText { text: root.server-url; }
                                PathText { text: root.root-path; }
                            }
                            if root.switch-revoked: Notice { text: root.translate("Previous connection removed", root.language); }
                            if !root.switch-revoked: Text { text: root.translate("Revoke this device's authorization? This device will no longer provide access to the committee's local files.", root.language); wrap: word-wrap; color: Palette.foreground; }
                            if root.unpair-failed: Notice { text: root.error-text; error: true; dismissible: false; }
                            Text { text: root.translate("Configuration and local files will be kept. Use a new storage directory to pair again.", root.language); wrap: word-wrap; color: Palette.alternate-foreground; }
                            if root.unpair-failed && !root.switch-committee: VerticalLayout { spacing: 8px;
                                Rule { }
                                Text { text: root.translate("You can unpair locally. Server authorization has not been confirmed revoked; saved configurations may still connect.", root.language); wrap: word-wrap; color: Palette.foreground; }
                                QuietButton { text: root.translate("Unpair locally", root.language); enabled: !root.busy && !root.running; clicked => {root.action("unpair-local");} }
                            }
                        }
                    }
                    HorizontalLayout { spacing: 12px;
                        cancel-unpair := Button { text: root.translate("Cancel", root.language); enabled: !root.busy; clicked => {root.confirm-unpair = false;} }
                        Rectangle { horizontal-stretch: 1; }
                        QuietButton { text: root.translate(root.busy ? root.status == "STOPPING" ? "STOPPING" : "Working" : root.switch-committee ? root.switch-revoked ? "Retry connection" : "Confirm switch" : root.running ? "Stop and disconnect" : "Revoke and unpair", root.language); danger: !root.switch-revoked || root.current-host != ""; min-height: 36px; enabled: !root.busy; clicked => {root.action(root.switch-committee ? "switch-committee" : "unpair");} }
                    }
                }
            }
        }
    }

    if root.copied-notice != "": Rectangle { x: (root.width - self.width) / 2; y: root.height - self.height - 20px; width: toast.preferred-width + 32px; height: 40px; background: Palette.foreground; border-radius: 6px;
        toast := Text { text: root.copied-notice; color: Palette.background; horizontal-alignment: center; vertical-alignment: center; }
    }

    if root.migration-active: Rectangle {
        background: #18273c99;
        TouchArea { }
        FocusScope {
            init => {self.focus();}
            key-pressed(event) => {if event.text == Key.Escape {return accept;} return reject;}
            Rectangle {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: min(620px, root.width - 48px); height: migration-body.preferred-height;
                background: Palette.background; border-radius: 12px;
                migration-body := VerticalLayout { padding: 28px; spacing: 18px;
                    Text { text: root.translate("File migration", root.language); font-size: 22px; color: Palette.foreground; }
                    Caption { text: root.translate("Server storage", root.language) + " → " + root.translate("Chair computer", root.language); }
                    Text { text: root.translate(root.migration-phase, root.language); color: Palette.foreground; wrap: word-wrap; }
                    HorizontalLayout {
                        Caption { text: root.translate("Verified", root.language) + " " + root.migration-count; }
                        Rectangle { horizontal-stretch: 1; }
                        Caption { text: root.migration-bytes; }
                    }
                    Rectangle { height: 7px; border-radius: 4px; background: Palette.alternate-background;
                        Rectangle { x: 0px; y: 0px; height: parent.height; width: parent.width * root.migration-fraction; border-radius: 4px; background: Palette.accent-background; }
                    }
                    if root.migration-file != "": VerticalLayout { spacing: 8px;
                        Text { text: root.migration-file; color: Palette.foreground; wrap: word-wrap; }
                        Caption { text: root.migration-file-bytes; }
                        Rectangle { height: 4px; background: Palette.alternate-background;
                            Rectangle { x: 0px; y: 0px; height: parent.height; width: parent.width * root.migration-file-fraction; background: Palette.accent-background; }
                        }
                    }
                    if root.migration-remaining != "": HorizontalLayout {
                        Caption { text: root.translate("Estimated time remaining", root.language); }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.migration-remaining; color: Palette.foreground; }
                    }
                    if root.migration-error != "": Notice { text: root.translate(root.migration-error, root.language); error: true; dismissible: false; }
                    if root.migration-phase == "MIGRATION_READY" || root.migration-phase == "MIGRATION_FAILED": QuietButton {
                        text: root.translate("Open storage settings", root.language); clicked => {root.action("open-migration");}
                    }
                }
            }
        }
    }

    if root.confirm-discard != "": Rectangle {
        background: #18273c80;
        TouchArea { }
        FocusScope {
            init => {self.focus();}
            key-pressed(event) => {if event.text == Key.Escape {root.confirm-discard = ""; return accept;} return reject;}
            Rectangle { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: 520px; height: discard-content.preferred-height; background: Palette.background; border-radius: 12px;
                discard-content := VerticalBox { padding: 24px; spacing: 20px;
                    Text { text: root.translate("Discard unsaved changes and continue?", root.language); wrap: word-wrap; color: Palette.foreground; font-size: 18px; }
                    HorizontalBox {
                        Button { text: root.translate("Cancel", root.language); clicked => {root.confirm-discard = "";} }
                        Button { text: root.translate("Discard and continue", root.language); clicked => {root.action("discard-" + root.confirm-discard);} }
                    }
                }
            }
        }
    }

    if root.overwrite-path != "": Rectangle {
        background: #18273c80;
        TouchArea { }
        FocusScope {
            init => {cancel-overwrite.focus();}
            key-pressed(event) => {
                if event.text == Key.Escape {root.overwrite-decision(false); return accept;}
                return reject;
            }
            Rectangle {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: min(560px, root.width - 48px); height: min(root.height - 48px, overwrite-body.preferred-height + 48px);
                background: Palette.background; border-radius: 12px;
                ScrollView { x: 24px; y: 24px; width: parent.width - 48px; height: parent.height - 48px;
                    overwrite-body := VerticalLayout { spacing: 20px;
                        Text { text: root.translate("Overwrite configuration?", root.language); color: Palette.foreground; font-size: 20px; wrap: word-wrap; }
                        PathText { text: root.overwrite-path; }
                        HorizontalLayout { spacing: 12px;
                            cancel-overwrite := Button { text: root.translate("Cancel", root.language); clicked => {root.overwrite-decision(false);} }
                            Rectangle { horizontal-stretch: 1; }
                            QuietButton { text: root.translate("Overwrite", root.language); danger: true; clicked => {root.overwrite-decision(true);} }
                        }
                    }
                }
            }
        }
    }

}
