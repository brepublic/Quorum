{
  "rules": {
    "system": {
      "bootstrapComplete": {
        ".read": true,
        ".write": false
      },
      "$other": {
        ".read": false,
        ".write": false
      }
    },
    "templates": {
      "$uid": {
        ".indexOn": ["countryTemplateKey"],
        ".read": "auth != null && auth.token.managed === true && auth.uid === $uid",
        ".write": "auth != null && auth.token.managed === true && auth.uid === $uid"
      }
    },
    "countryTemplates": {
      "$uid": {
        ".read": "auth != null && auth.token.managed === true && auth.uid === $uid",
        ".write": "auth != null && auth.token.managed === true && auth.uid === $uid"
      }
    },
    "committees": {
      ".indexOn": ["creatorUid"],
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.token.managed === true && (newData.child('creatorUid').val() === auth.uid || data.child('creatorUid').val() === auth.uid)",
        "caucuses": {
          "$cid": {
            "queue": {
              "$qid": {
                ".write": "!data.exists() && newData.exists() && data.parent().parent().child('queueIsPublic').val() === true && newData.child('memberID').isString() && root.child('committees').child($uid).child('members').child(newData.child('memberID').val()).child('present').val() === true && root.child('committees').child($uid).child('members').child(newData.child('memberID').val()).child('name').val() === newData.child('who').val()"
              }
            }
          }
        },
        "resolutions": {
          "$rid": {
            "amendments": {
              "$aid": {
                ".write": "newData.exists() && data.parent().parent().child('amendmentsArePublic').val() === true"
              }
            }
          }
        },
        "files": {
          "$fid": {
            ".write": "newData.exists()"
          }
        },
        "strawpolls": {
          "$sid": {
            "options": {
              "$oid": {
                ".write": "newData.exists() && data.parent().parent().child('optionsArePublic').val() === true",
                "votes": {
                  "$vid": {
                    ".write": true
                  }
                }
              }
            }
          }
        },
        "motions": {
          "$mid": {
            ".write": "!data.exists() && newData.exists() && !newData.child('deleted').exists() && data.parent().parent().child('settings').child('motionsArePublic').val() === true && newData.child('proposerID').isString() && root.child('committees').child($uid).child('members').child(newData.child('proposerID').val()).child('present').val() === true && root.child('committees').child($uid).child('members').child(newData.child('proposerID').val()).child('name').val() === newData.child('proposer').val() && (!newData.child('seconder').exists() || (newData.child('seconderID').isString() && root.child('committees').child($uid).child('members').child(newData.child('seconderID').val()).child('present').val() === true && root.child('committees').child($uid).child('members').child(newData.child('seconderID').val()).child('name').val() === newData.child('seconder').val()))",
            "votes": {
              "$vid": {
                ".write": "data.parent().parent().parent().parent().child('settings').child('motionVotes').val() === true && root.child('committees').child($uid).child('members').child($vid).child('present').val() === true",
                ".validate": "newData.val() === 'For' || newData.val() === 'Against' || newData.val() === 'Abstaining'"
              }
            }
          }
        }
      }
    }
  }
}
