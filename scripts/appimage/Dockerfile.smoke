FROM ubuntu:22.04@sha256:5ec03bb3441e8b0bf3b4f9cd4629a1ae763010dc3035bb8da3ae6cf026486401
ARG DEBIAN_FRONTEND=noninteractive
# No compiler, Node, GTK, Zenity, portal backend or CJK fonts. Only the host
# desktop services needed by the virtual-X11 startup check are present.
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb dbus-x11 xdg-utils python3 && rm -rf /var/lib/apt/lists/*
